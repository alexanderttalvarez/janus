{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["godot-prompter@git+https://github.com/jame581/GodotPrompter.git"],
  "mcp": {
    "trello": {
      "type": "local",
      "command": ["npx", "-y", "trello-mcp-server"],
      "environment": {
        "TRELLO_API_KEY": "{env:TRELLO_API_KEY}",
        "TRELLO_API_TOKEN": "{env:TRELLO_API_TOKEN}"
      },
      "enabled": true
    },
    "godot": {
      "type": "local",
      "command": ["npx", "-y", "@coding-solo/godot-mcp"],
      "environment": {
        "GODOT_PATH": "/usr/local/bin/godot"
      },
      "enabled": false
    },
    "godotiq": {
      "type": "local",
      "command": ["/home/aelxan/.local/bin/uvx", "godotiq"],
      "environment": {
        "GODOTIQ_PROJECT_ROOT": "/home/aelxan/Programming/Games/janus"
      },
      "timeout": 80000,
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 80000
  }
}
